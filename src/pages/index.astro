---
import "../fonts.css";
import "../styles.css";
import { APPS } from "../lib/apps";
import { localVoice } from "../lib/voice";
import { builderAvailable } from "../lib/local-build";
import { boxAllowed, pickAllowed } from "../lib/box";
import { guestHere } from "../lib/guest";
// a computer without an Own1 runs chat only, plus speech when it has it; the page hides what isn't here
const local = process.env.NEXY_STUDIOS === "off";
// Nexy Cloud: hosted, chat only (with NEXY_STUDIOS=off), named as such
const cloud = process.env.NEXY_PLACE === "cloud";
// whole-box features for this request (src/lib/box.ts): the page shows only what the server allows
const box = boxAllowed(Astro.request);
const engines = pickAllowed(Astro.request);
// speech on this computer is a box feature too (api/v1/voice)
const voice = local && box && localVoice();
// building on this computer: the engine's builder, with or without the Own Build studio
const builder = local && await builderAvailable();
const ids = APPS.map((a) => a.id);
const apps = [...ids, ...(voice ? ["voice"] : []), ...(builder ? ["builder"] : [])].join(" ");
const projects = APPS.some((a) => a.id === "startup");
const beta = process.env.NEXY_BETA === "1";
// web search: an Own1 has its own; a computer only when one is configured
const search = !local || !!process.env.NEXY_SEARXNG_URL;
// the desktop app's version, for problem reports and About
const version = process.env.NEXY_APP_VERSION || undefined;
// the desktop app takes pictures of its own window for reports (api/v1/screenshot)
const shot = !!process.env.NEXY_LOG_TAIL_URL;
// what this computer's model can do (the desktop app's capability file): the page holds back the rest
const caps = local ? process.env.NEXY_CAPS || undefined : undefined;
// a shared Own 1 reached with a guest code: text only, so no image attachments (src/lib/guest.ts)
const guest = local && guestHere();
---
<!DOCTYPE html>
<html lang="en" data-place={cloud ? "cloud" : local ? "computer" : "own1"} data-apps={apps} data-beta={beta ? "1" : undefined} data-guest={guest ? "1" : undefined} data-voice={voice ? "local" : undefined} data-search={search ? "1" : undefined} data-version={version} data-app-shot={shot ? "1" : undefined} data-box={box ? "1" : undefined} data-engines={engines ? "1" : undefined} data-caps={caps}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Nexy</title>
</head>
<body>
<div class="wp"><canvas class="aurora" id="aurora" aria-hidden="true"></canvas><div class="grain"></div></div>




<div class="stage">
  <!-- rail -->
  <aside class="rail">
    <div class="ws"><svg class="glyph" viewBox="0 0 1620 1420" aria-hidden="true"><g fill="#fff"><path d="M640 118C300 132 185 336 185 710c0 374 115 578 455 592l55-115c-283-14-375-176-375-477 0-301 92-463 375-477z"/><path d="M980 118c340 14 455 218 455 592 0 374-115 578-455 592l-55-115c283-14 375-176 375-477 0-301-92-463-375-477z"/><rect x="520" y="592" width="180" height="326" rx="90"/><rect x="965" y="592" width="180" height="326" rx="90"/></g></svg><div class="n">Nexy</div><button class="hbtn" id="railTog" title="Hide the sidebar ( [ )"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M9 5v14"/></svg></button></div>
    <div class="sidebtns">
      <button class="sbtn" id="newChat"><svg class="i" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New chat<span class="kbd">N</span></button>
      <button class="sbtn" id="openCmd"><svg class="i" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>Search<span class="kbd">⌘K</span></button>
    </div>
    <div class="list">
      <div id="exWrap" hidden><div class="st">Examples</div><div id="exList"></div></div>
      <div id="chatWrap" hidden><div class="st">Chats</div><div id="chatList"></div></div>
      <div class="st" hidden={!projects}>Projects<button type="button" id="newProject" title="New project"><svg class="i" style="width:13px;height:13px" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button></div>
      <div id="projList" hidden={!projects}></div>
      <div hidden><button type="button" id="addConn"></button><div id="connList"></div><div id="teamList"></div><span id="wsName"></span><span id="wsBtn"></span></div>
    </div>
    <div class="gs" id="gs" hidden></div>
    <div class="userwrap">
      <div class="pmenu" id="pmenu">
        <div class="pm-h"><div class="avatar">O</div><div><div class="n">Owner</div><div class="d">this machine</div></div></div>
        <div class="pm-sec">Workspace</div>
        <div id="pmWs"></div>
        <div class="pm-sec"></div>
        <button type="button" class="pm-i" id="settingsBtn">Settings</button>
        <button type="button" class="pm-i" id="pmTeam">Team</button>
        <button type="button" class="pm-i" id="pmConn">Connections</button>
        <button type="button" class="pm-i" id="pmKeys">Keyboard shortcuts</button>
        <button type="button" class="pm-i" id="pmHelp">Help</button>
      </div>
      <button class="user" type="button" id="profileBtn"><div class="avatar">O</div><div><div class="n">Owner</div><div class="d" id="pmWsName">{cloud ? "Nexy Cloud" : local ? "This computer" : "Own1"}</div></div><svg class="i" style="margin-left:auto;color:var(--fg3)" viewBox="0 0 24 24"><path d="m8 14 4-4 4 4"/></svg></button>
    </div>
  </aside>

  <!-- centre -->
  <main class="main">
    <div hidden><span id="pEm"></span><span id="pName"></span><span id="pLoc"></span><span id="pAgents"></span><button id="moveBtn"></button><button id="shareBtn"></button><span id="hdrStatus"></span></div>
    <!-- the tabs scroll; the tools beside them stay put (inside the scroll they slid under the tabs) -->
    <div class="tabrow">
    <div class="tabs" id="tabs">
      <button class="tab active" data-tab="chat">Chat</button>
      <button class="tab" data-tab="apps" hidden={local}>Apps <span class="c" id="cApps">0</span></button>
      <button class="tab" data-tab="files">Files <span class="c" id="cFiles">0</span></button>
      <button class="tab" data-tab="tasks" hidden={!projects}>Tasks <span class="c" id="cTasks">0</span></button>
      <button class="tab" data-tab="agents" hidden={!projects}>Agents <span class="c" id="cAgents">0</span></button>
      <button class="tab" data-tab="activity" hidden={local}>Activity</button>
    </div>
      <div class="tabtools">
        <button type="button" class="chip" id="hdrEngine" hidden></button>
        <button class="hbtn" id="railOpen" title="Show the sidebar ( [ )" hidden><svg class="i" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M9 5v14"/></svg></button>
        <button class="hbtn" id="hdrNeeds" title="Needs you" hidden><svg class="i" viewBox="0 0 24 24"><path d="M12 3l9 16H3L12 3Z"/><path d="M12 10v4M12 17h.01"/></svg><b id="hdrNeedCount">0</b></button>
        <button class="hbtn" id="hdrProject" title="This project" hidden><svg class="i" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="3"/><path d="M8 10h8M8 14h5"/></svg></button>
        <button class="hbtn" id="hdrWork" title="Show or hide the work" hidden><svg class="i" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="3"/><path d="M3 9h18M8 21h8"/></svg></button>
        {/* a beta's BETA button is its report button; other builds keep the plain one */}
        {beta ? <button class="betabadge" id="betaBtn" title="Nexy Beta: report a problem or share an idea" aria-label="Nexy Beta: report a problem"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z"/><path d="M9 10.5h6"/></svg>BETA</button>
          : <button class="hbtn" id="reportBtn" title="Report a problem" aria-label="Report a problem"><svg class="i" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4V5Z"/><path d="M12 8v3M12 13.5h.01"/></svg></button>}
      </div>
    </div>

    <section class="view active" data-view="chat">
      <div class="gsm" id="gsM" hidden></div>
      <div class="thread" id="thread"></div>
      <div class="composer">
        <div class="chips" id="chips"></div>
        <div id="pickChip" class="pickchip" hidden></div>
        <div class="chips" id="vreview" role="group" aria-label="Check what you said" hidden><span class="muted vhint">Check the words, then send.</span><button type="button" class="chip" id="vsend">Send<span class="kbd">Enter</span></button><button type="button" class="chip" id="vredo" title="Discard this and say it again" aria-label="Redo: discard this and say it again">Redo<span class="kbd">Esc</span></button></div>
        <div class="line">
          <button type="button" class="wavebtn" id="waveBtn" hidden={!apps.split(" ").includes("voice")} title="Talk with Nexy"><canvas class="mini" id="miniWave" aria-hidden="true"></canvas></button>
          <textarea id="input" rows="1" placeholder="Talk to Nexy"></textarea>
          <div class="keys">
            <input type="file" id="filePick" multiple hidden>
            <button type="button" id="privBtn" aria-pressed="false" aria-label="Private chat" title="Ultra-private chat: nothing is saved, no web search, it stays on this device"><svg class="i" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span class="pl">Private</span></button>
            <button type="button" id="attachBtn" title="Attach files"><svg class="i" viewBox="0 0 24 24"><path d="m20 11-8.5 8.5a5 5 0 0 1-7-7L13 4a3.3 3.3 0 0 1 4.7 4.7L9.4 17a1.7 1.7 0 0 1-2.4-2.4L15 6.6"/></svg></button>
            <button type="button" id="voiceMode" title="Voice mode: talk with Nexy" hidden><svg class="i" viewBox="0 0 24 24"><path d="M3 12h2M7 8v8M11 5v14M15 9v6M19 7v10M22 12h-1"/></svg></button>
            <button type="button" id="micBtn" hidden={!apps.split(" ").includes("voice")} title="Hold to talk, or tap to start and stop" aria-label="Talk: hold to speak"><svg class="i" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg></button>
            <button type="button" id="sendBtn" disabled aria-label="Send"><svg class="i" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button>
          </div>
        </div>
        <div hidden><button type="button" id="route"></button></div>
      </div>
    </section>
    <section class="view" data-view="tasks"><div class="pad"><div class="board" id="board"></div></div></section>
    <section class="view" data-view="apps"><div class="pad"><div class="fgrid" id="agrid"></div></div></section>
    <section class="view" data-view="files"><div class="pad"><div class="fgrid" id="fgrid"></div></div></section>
    <section class="view" data-view="agents"><div class="pad" id="agentsView"></div></section>
    <section class="view" data-view="activity"><div class="pad" id="activityView"></div></section>
  </main>

  <!-- canvas -->
  <section class="canvas" id="canvas" aria-label="Work">
    <div class="splitter" id="splitter" title="Drag to resize"></div>
    <div class="cvtabs" id="cvTabs"></div>
    <div class="cvhead"><span class="t" id="cvTitle"></span><span class="m" id="cvMeta" hidden></span><div class="acts"><button class="btn small ghost" id="cvPick" title="Click a part of the page, then say what to change in it" style="display:none"><svg class="i" viewBox="0 0 24 24"><path d="M5 3l6 16 2-7 7-2z"/></svg><span class="txt">Select</span></button><button class="btn small ghost" id="cvEdit"><svg class="i" viewBox="0 0 24 24"><path d="M4 20l4-1 11-11-3-3L5 16z"/></svg><span class="txt">Edit</span></button><button class="btn small" id="cvOpenApp"><span class="txt">Open</span></button><button class="btn small ghost" id="cvDownload" title="Download"><svg class="i" viewBox="0 0 24 24"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14"/></svg></button><button class="btn small ghost" id="cvMax" title="Full width"><svg class="i" viewBox="0 0 24 24"><path d="M9 6H5v4M15 18h4v-4M19 10V6h-4M5 14v4h4"/></svg></button><button class="btn small ghost" id="cvClose" title="Close"><svg class="i" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div></div>
    <div class="cvbody" id="cvBody"></div>
  </section>

</div>

<aside class="panel" id="panel">
  <div class="ph"><span id="panelTitle">This project</span><button class="x" type="button" id="panelClose">×</button></div>
  <div class="pb">
    <div class="psec active" data-sec="needs"><div class="rst">Needs you</div><div id="needs"></div></div>
    <div class="psec" data-sec="project"><div class="rst">This project</div>
      <div class="kv"><div><div class="l">Progress</div><div class="v" id="rProg">0%</div></div><div><div class="l">Files</div><div class="v" id="rFiles">0</div></div></div>
      <div class="progress" style="margin:10px 0 4px"><i id="rBar" style="width:0"></i></div>
      <div class="faint" style="font-size:11.5px" id="rNext"></div>
      <div class="rst">Nexy recommends</div><div id="recos"></div>
    </div>
    <div class="psec" data-sec="team"><div class="rst">Team on it</div><div id="rAgents"></div></div>
    <div class="psec" data-sec="where"><div class="rst">Where this project lives</div><div class="loc"><span class="led"></span><div class="l"><span id="rLoc">Own 1, this desk</span><small>history, files, agents and memory are here</small></div></div><div class="faint" style="font-size:11.5px;line-height:1.5;margin-top:8px">Move takes everything with it: history, files, agents, permissions and memory. This machine becomes a window.</div><button class="btn" style="margin-top:12px" id="moveBtn2">Move this project</button></div>
  </div>
</aside>

<div class="ov" id="ovCmd"><div class="modal cmd"><input id="cmdIn" placeholder="Search projects, chats and files, or type what you want" autocomplete="off"><div class="res" id="cmdRes"></div></div></div>
<div class="ov" id="ovProj"><div class="modal">
  <div class="mh">New project<button class="x" type="button" data-close>×</button></div>
  <div class="mb">
    <div class="field"><label>Name</label><input id="npName" placeholder="Investor update"></div>
    <div class="field"><label>What should Nexy do first?</label><textarea id="npGoal" rows="3" placeholder="Pull September numbers from the vault, draft a one-page update, and prepare a three-slide summary."></textarea></div>
    <div class="field"><label>Where it lives</label>
      <div class="opt sel" data-loc="Own 1, this desk"><span class="led"></span><div class="l">Own 1, this desk<small>Everything stays on this machine</small></div></div>
      <div class="opt" data-loc="OwnCloud, EU-West"><span class="led cloud"></span><div class="l">OwnCloud, EU-West<small>For heavy jobs; you approve each cost</small></div></div>
    </div>
    <div class="field"><label>Privacy</label><div class="opt sel" data-priv="0"><span class="led"></span><div class="l">Regular<small>Runs on device; cloud and outside apps only when you approve them</small></div></div><div class="opt" data-priv="1"><span class="led warn"></span><div class="l">Ultra-private<small>Encrypted at rest. Never leaves this device: no cloud, no outside apps, no publishing</small></div></div></div>
  </div>
  <div class="mf"><button class="btn" type="button" data-close>Cancel</button><button class="btn primary" type="button" id="npCreate">Create and start</button></div>
</div></div>
<div class="ov" id="ovMove"><div class="modal">
  <div class="mh">Move project<button class="x" type="button" data-close>×</button></div>
  <div class="mb">
    <div class="faint" style="margin-bottom:10px;font-size:12.5px">Moves history, files, agents, permissions and memory together. Nothing is re-trained.</div>
    <div class="field"><label>To a workspace</label><div id="mvWs"></div></div>
    <div class="field"><label>Or to another machine</label><div id="mvDev"></div></div>
  </div>
  <div class="mf"><button class="btn" type="button" data-close>Cancel</button><button class="btn primary" type="button" id="mvGo">Move</button></div>
</div></div>
<div class="ov" id="ovConn"><div class="modal"><div class="mh">Connect an app<button class="x" type="button" data-close>×</button></div><div class="mb" id="connOpts"></div></div></div>
<div class="ov" id="ovSet"><div class="modal set">
  <div class="mh">Settings<button class="x" type="button" data-close>×</button></div>
  <div class="setwrap"><nav class="setnav" id="setNav"></nav><div class="setbody" id="setBody"></div></div>
</div></div>
<input type="file" id="bgPick" accept="image/*" hidden>
<input type="file" id="demoPick" accept="image/*" multiple hidden>
<div class="vmode" id="vmode">
  <button class="vm-x" id="vmClose" type="button" aria-label="Close"><svg class="i" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  <div class="vm-center">
    <canvas id="vmWave"></canvas>
    <div class="vm-state" id="vmState"></div>
    <div class="vm-cap"><div class="vm-you" id="vmYou"></div><div class="vm-nexy" id="vmNexy"></div></div>
    <div class="vm-ctl"><button class="vm-btn" id="vmMic" type="button" title="Talk"><svg class="i" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg></button><button class="btn small" id="vmTap" type="button" hidden>Tap when you are done talking</button></div>
  </div>
</div>
<div class="voice" id="voice"><span class="led warn"></span><canvas id="vwave" width="320" height="72"></canvas><span class="muted" id="vtext" aria-live="polite">Listening…</span><button class="btn small" id="vstop" aria-label="Done talking">Done</button></div>
<div class="toast" id="toast"><span class="led"></span><span id="toastT"></span></div>

<script>
  import "../client/nexy";
</script>
</body>
</html>
